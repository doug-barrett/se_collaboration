{# ================= Pre-SQL ================= #}
{# config.preSQL is a plain string ("select 1"), not an object #}
{% if config.preSQL is defined and (config.preSQL | trim) != '' %}
    {{ stage('Pre-SQL') }}
    {{ config.preSQL }}
{% endif %}

{# ================= Truncate ================= #}
{# truncateBefore is its own boolean toggle, independent of insertStrategy #}
{% if config.truncateBefore %}
    {{ stage('Truncate Target') }}
    TRUNCATE TABLE {{ this }}
{% endif %}

{# ================= Load ================= #}
{# insertStrategy is a plain string: compare it directly #}
{% if config.insertStrategy == 'MERGE' %}

    {{ stage('Merge Data') }}
    MERGE INTO {{ this }} "TGT"
    USING (
        {% for source in sources %}
            {{ source.cteString }}
            SELECT
                {% for col in source.columns %}
                    {{ get_source_transform(col) }} AS "{{ col.name }}"{{ "," if not loop.last }}
                {% endfor %}
            {{ source.join }}
            {% if not loop.last %}UNION ALL{% endif %}
        {% endfor %}
    ) "SRC"
    ON  {% for col in columns if col.isBusinessKey %}{{ "AND " if not loop.first }}"TGT"."{{ col.name }}" = "SRC"."{{ col.name }}"
        {% endfor %}
    WHEN MATCHED THEN UPDATE SET
        {% for col in columns if not col.isBusinessKey %}
        "TGT"."{{ col.name }}" = "SRC"."{{ col.name }}"{{ "," if not loop.last }}
        {% endfor %}
    WHEN NOT MATCHED THEN INSERT (
        {% for col in columns %}
        "{{ col.name }}"{{ "," if not loop.last }}
        {% endfor %}
    )
    VALUES (
        {% for col in columns %}
        "SRC"."{{ col.name }}"{{ "," if not loop.last }}
        {% endfor %}
    )

{% else %}

    {{ stage('Insert Data') }}
    INSERT INTO {{ this }}
    (
        {% for col in columns %}
        "{{ col.name }}"{{ "," if not loop.last }}
        {% endfor %}
    )
    {% for source in sources %}
        {{ source.cteString }}
        SELECT
            {% for col in source.columns %}
            {{ get_source_transform(col) }} AS "{{ col.name }}"{{ "," if not loop.last }}
            {% endfor %}
        {{ source.join }}
        {% if not loop.last %}UNION ALL{% endif %}
    {% endfor %}

{% endif %}

{# ================= Post-SQL ================= #}
{# config.postSQL is a plain string; empty string here, so this stage is skipped #}
{% if config.postSQL is defined and (config.postSQL | trim) != '' %}
    {{ stage('Post-SQL') }}
    {{ config.postSQL }}
{% endif %}

{# ================= Tests ================= #}
{% if config.testsEnabled %}

    {# config.tests.items is the list itself -- iterate it directly #}
    {% if config.tests is defined and config.tests['items'] is defined %}
        {% for test in config.tests['items'] %}
            {{ test_stage(test.testName | default('Test ' ~ loop.index, true)) }}
            {{ test.testSql }}
        {% endfor %}
    {% endif %}

    {# column.tests is a plain list (currently [] on every column) #}
    {% for column in columns %}
        {% for test in column.tests %}
            {{ test_stage(column.name ~ ': Test ' ~ loop.index) }}
            {{ test }}
        {% endfor %}
    {% endfor %}

{% endif %}